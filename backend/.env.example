# Live executes OpenAI -> Codex -> GitHub PR -> GitHub issue comment.
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BUGPILOT_FRONTEND_URL=http://127.0.0.1:5173
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-before-deploying
# GitHub token needs Issues, Contents and Pull Requests read/write access.
# Preprocessing uses this key, or falls back to CODEX_API_KEY.
OPENAI_API_KEY=
# Lower-cost model for structured preprocessing and repository selection.
OPENAI_PREPROCESS_MODEL=gpt-6-luna
GITHUB_TOKEN=
# Coding uses this key, or falls back to OPENAI_API_KEY.
CODEX_API_KEY=
# Optional: leave empty to use the Codex CLI default model.
CODEX_MODEL=
CODEX_BIN=codex
# Native Windows sandbox. MXC requires a compatible Windows host; no automatic fallback.
BUGPILOT_WINDOWS_SANDBOX=mxc
BUGPILOT_AGENT_TIMEOUT=1200
BUGPILOT_TEST_TIMEOUT=300
BUGPILOT_TEST_MEMORY=2g
# First-time automatic dependency image preparation (separate from offline tests).
BUGPILOT_VALIDATION_SETUP_TIMEOUT=1200
BUGPILOT_GIT_NETWORK_TIMEOUT=600
BUGPILOT_LEASE_SECONDS=1800
# BUGPILOT_WORKSPACE_ROOT=/srv/bugpilot/workspaces
# Production: DEBUG=false, a random secret, HTTPS, and explicit hosts/origins.
# CSRF_TRUSTED_ORIGINS=https://bugpilot.example.com
# TRUST_PROXY=true

# Optional, only for historical Jira investigations / legacy API clients:
# JIRA_BASE_URL=https://your-team.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
